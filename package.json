{
  "name": "vite-plugin-iconify-offline",
  "version": "0.1.0",
  "description": "Vite 插件：构建时自动扫描 Iconify 图标引用并预注册，实现零运行时开销的离线图标方案",
  "keywords": [
    "vite",
    "vite-plugin",
    "iconify",
    "offline",
    "icon",
    "vue",
    "react"
  ],
  "license": "MIT",
  "author": "AkagiYui",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "devDependencies": {
    "@iconify-icon/solid": "^3.0.3",
    "@iconify-json/lucide": "^1.2.108",
    "@iconify/vue": "^5.0.1",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "solid-js": "^1.9.13",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AkagiYui/vite-plugin-iconify-offline"
  },
  "homepage": "https://github.com/AkagiYui/vite-plugin-iconify-offline",
  "bugs": ""
}
